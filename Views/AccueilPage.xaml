<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Auto237.ViewModels"
             xmlns:views="clr-namespace:Auto237.Views"
             x:Class="Auto237.Views.AccueilPage"
             Title="Accueil"
             BackgroundColor="#F2F2F2">
    <ContentPage.BindingContext>
        <vm:AccueilViewModel />
    </ContentPage.BindingContext>
    <Grid RowDefinitions="Auto,Auto,*" Padding="0" RowSpacing="0">
        <Border Grid.RowSpan="3" MaximumWidthRequest="480" HorizontalOptions="Fill" BackgroundColor="White" StrokeThickness="0">
            <Grid RowDefinitions="Auto,Auto,*" Padding="12,8" RowSpacing="6">
                <views:AppHeader Grid.Row="0" />
                <VerticalStackLayout Grid.Row="1" Spacing="6">
                    <SearchBar Placeholder="Rechercher un véhicule..." Text="{Binding Recherche}" SearchCommand="{Binding ChargerCommand}" BackgroundColor="{StaticResource EntryGray}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                        <Picker Title="Ville" ItemsSource="{Binding Villes}" SelectedItem="{Binding Ville}" SelectedIndexChanged="OnFiltreChanged" />
                        <Picker Grid.Column="1" Title="Boîte" ItemsSource="{Binding Boites}" SelectedItem="{Binding Boite}" SelectedIndexChanged="OnFiltreChanged" />
                        <Picker Grid.Column="2" Title="Type" ItemsSource="{Binding Types}" SelectedItem="{Binding TypeOffre}" SelectedIndexChanged="OnFiltreChanged" />
                    </Grid>
                </VerticalStackLayout>
                <RefreshView Grid.Row="2" Command="{Binding ChargerCommand}" IsRefreshing="{Binding Chargement}">
                    <CollectionView ItemsSource="{Binding Annonces}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <views:AnnonceCard>
                                    <views:AnnonceCard.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OuvrirDetailCommand}" CommandParameter="{Binding Id}" />
                                    </views:AnnonceCard.GestureRecognizers>
                                </views:AnnonceCard>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="24" Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="{Binding MessageVide}" HorizontalOptions="Center" TextColor="{StaticResource TextGray}"
                                       IsVisible="{Binding EstVide}" LineBreakMode="WordWrap" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding MessageErreur}" HorizontalOptions="Center" TextColor="{StaticResource PriceRed}"
                                       IsVisible="{Binding EstErreur}" LineBreakMode="WordWrap" HorizontalTextAlignment="Center" />
                                <Button Text="Réessayer" Command="{Binding ChargerCommand}" IsVisible="{Binding EstErreur}"
                                        BackgroundColor="{StaticResource PrimaryViolet}" TextColor="White" CornerRadius="8" HorizontalOptions="Center" />
                                <Button Text="Se reconnecter" Command="{Binding SeReconnecterCommand}" IsVisible="{Binding SessionExpiree}"
                                        BackgroundColor="{StaticResource PriceRed}" TextColor="White" CornerRadius="8" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </RefreshView>
            </Grid>
        </Border>
    </Grid>
</ContentPage>

