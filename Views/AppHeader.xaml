<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Auto237.Views"
             x:Class="Auto237.Views.AppHeader">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,4" VerticalOptions="Start">
        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
            <views:LogoCameroun Taille="22" HorizontalOptions="Start" />
            <Label Text="Achat &#8226; Location" FontSize="10" TextColor="{StaticResource TextGray}" Margin="2,0,0,0" />
        </VerticalStackLayout>
        <Border Grid.Column="1" Stroke="{StaticResource PrimaryViolet}" StrokeThickness="1.5"
                StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40"
                HorizontalOptions="End" VerticalOptions="Center" Padding="0" BackgroundColor="White">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnProfilClicked" />
            </Border.GestureRecognizers>
            <Image Source="user.svg" WidthRequest="28" HeightRequest="28"
                   HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>
    </Grid>
</ContentView>
