<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Auto237.Views.BackHeader">
    <Grid ColumnDefinitions="48,*" ColumnSpacing="8" Padding="0,4" VerticalOptions="Start">
        <Button Grid.Column="0" Text="&lt;" Clicked="OnBackClicked"
                BackgroundColor="#EEEEEE" TextColor="Black" FontSize="20" FontAttributes="Bold"
                WidthRequest="44" HeightRequest="44" CornerRadius="22"
                HorizontalOptions="Start" VerticalOptions="Center" AutomationId="BtnBack" />
        <Label Grid.Column="1" Text="{Binding Title, Source={RelativeSource AncestorType={x:Type ContentView}}}"
               FontSize="18" FontAttributes="Bold" TextColor="Black" VerticalOptions="Center" />
    </Grid>
</ContentView>
