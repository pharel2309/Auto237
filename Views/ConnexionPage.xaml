<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Auto237.ViewModels"
             xmlns:views="clr-namespace:Auto237.Views"
             x:Class="Auto237.Views.ConnexionPage"
             Title="Connexion"
             BackgroundColor="White">
    <ContentPage.BindingContext>
        <vm:ConnexionViewModel />
    </ContentPage.BindingContext>
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Center">
            <views:LogoCameroun Taille="28" />
            <Label Text="CONNEXION" HorizontalOptions="Center" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextDark}" />
            <Label Text="Email" Style="{StaticResource LabelForm}" />
            <Entry Placeholder="Ex. admin@gmail.com" Text="{Binding Email}" Keyboard="Email" />
            <Label Text="Mot de passe" Style="{StaticResource LabelForm}" />
            <Entry Placeholder="Ton mot de passe" Text="{Binding Password}" IsPassword="True" />
            <Label Text="{Binding Erreur}" TextColor="{StaticResource PriceRed}" IsVisible="{Binding Erreur, Converter={StaticResource IsNotNullConverter}}" />
            <Button Text="Mot de passe oublié ?" Command="{Binding AllerRecuperationCommand}" AutomationId="LienRecup"
                    BackgroundColor="Transparent" TextColor="{StaticResource TitleBlue}" HorizontalOptions="End" />
            <Button Text="Se connecter" Command="{Binding ConnecterCommand}" IsEnabled="{Binding Chargement, Converter={StaticResource InverseBoolConverter}}"
                    BackgroundColor="{StaticResource PrimaryViolet}" TextColor="White" CornerRadius="4" WidthRequest="160" HorizontalOptions="Center">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding Chargement}" Value="True">
                        <Setter Property="Text" Value="Connexion..." />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Padding="0,20,0,0"  VerticalOptions="Center">
                <Label Text="Pas de compte ?" VerticalOptions="Center" TextColor="Black" />
                <Button Text="S'inscrire" Command="{Binding AllerInscriptionCommand}" AutomationId="LienInscription"
                        BackgroundColor="Transparent" TextColor="{StaticResource TitleBlue}" Padding="2,4" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
