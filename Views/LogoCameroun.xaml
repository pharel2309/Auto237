<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Auto237.Views.LogoCameroun">
    <Label x:Name="LogoLabel" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" CharacterSpacing="1">
        <Label.FormattedText>
            <FormattedString>
                <Span Text="Auto" TextColor="{StaticResource TextDark}" />
                <Span Text="2" TextColor="{StaticResource CamerounVert}" />
                <Span Text="3" TextColor="{StaticResource CamerounRouge}" />
                <Span Text="7" TextColor="{StaticResource CamerounJaune}" />
            </FormattedString>
        </Label.FormattedText>
    </Label>
</ContentView>
