<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Auto237.ViewModels"
             xmlns:views="clr-namespace:Auto237.Views"
             x:Class="Auto237.Views.ModifierMotDePassePage"
             Title="Modifier mot de passe"
             BackgroundColor="White">
    <ContentPage.BindingContext>
        <vm:ModifierMotDePasseViewModel />
    </ContentPage.BindingContext>
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Start">
            <views:BackHeader Title="Mot de passe" BackCommand="{Binding RetourCommand}" />
            <Label Text="Ancien mot de passe" Style="{StaticResource LabelForm}" />
            <Entry Placeholder="Saisis ton mot de passe actuel" Text="{Binding AncienMotDePasse}" IsPassword="True" />
            <Label Text="Nouveau mot de passe" Style="{StaticResource LabelForm}" />
            <Entry Placeholder="6 caractères minimum" Text="{Binding NouveauMotDePasse}" IsPassword="True" />
            <Label Text="Confirmer le nouveau mot de passe" Style="{StaticResource LabelForm}" />
            <Entry Placeholder="Répète le nouveau mot de passe" Text="{Binding ConfirmationMotDePasse}" IsPassword="True" />
            <Label Text="{Binding Erreur}" TextColor="{StaticResource PriceRed}" LineBreakMode="WordWrap" />
            <Button Text="Changer le mot de passe" Command="{Binding ChangerCommand}" IsEnabled="{Binding Chargement, Converter={StaticResource InverseBoolConverter}}" BackgroundColor="{StaticResource PrimaryViolet}" TextColor="White" CornerRadius="4" WidthRequest="260" HorizontalOptions="Center">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding Chargement}" Value="True">
                        <Setter Property="Text" Value="Changement..." />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>