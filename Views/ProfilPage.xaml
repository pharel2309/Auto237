<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Auto237.ViewModels"
             xmlns:views="clr-namespace:Auto237.Views"
             x:Class="Auto237.Views.ProfilPage"
             Title="Profil"
             BackgroundColor="White">
    <ContentPage.BindingContext>
        <vm:ProfilViewModel />
    </ContentPage.BindingContext>
    <ScrollView>
    <VerticalStackLayout Padding="16" Spacing="12" VerticalOptions="Start">
        <views:BackHeader Title="Profil" BackCommand="{Binding RetourCommand}" />
        <Border Stroke="{StaticResource Gray100}" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="16,14" BackgroundColor="White">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.08" Radius="8" Offset="0,2" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Border Stroke="{StaticResource PrimaryViolet}" StrokeThickness="2" StrokeShape="RoundRectangle 48" WidthRequest="96" HeightRequest="96" Padding="0" HorizontalOptions="Center">
                    <Image Source="{Binding PhotoAffichee}" WidthRequest="92" HeightRequest="92" Aspect="AspectFill" BackgroundColor="{StaticResource PlaceholderGray}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="{Binding NomAffiche}" HorizontalOptions="Center" FontAttributes="Bold" FontSize="18" TextColor="{StaticResource TextDark}" />
                <Label Text="{Binding Email}" HorizontalOptions="Center" FontSize="13" TextColor="{StaticResource TextGray}" />
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Border StrokeThickness="0" BackgroundColor="{Binding EstAgence, Converter={StaticResource BadgeVendeurFondConverter}}" StrokeShape="RoundRectangle 12" Padding="10,4">
                        <Label Text="{Binding RoleAffiche}" FontSize="11" FontAttributes="Bold" TextColor="{Binding EstAgence, Converter={StaticResource BadgeVendeurTexteConverter}}" />
                    </Border>
                    <Border StrokeThickness="0" BackgroundColor="#E8F5E9" StrokeShape="RoundRectangle 12" Padding="10,4">
                        <Label Text="{Binding Quota}" FontSize="11" FontAttributes="Bold" TextColor="#2E7D32" />
                    </Border>
                </HorizontalStackLayout>
                <Button Text="Changer la photo" Command="{Binding ChangerPhotoCommand}" IsEnabled="{Binding Chargement, Converter={StaticResource InverseBoolConverter}}" BackgroundColor="Transparent" TextColor="{StaticResource TitleBlue}" HorizontalOptions="Center" HeightRequest="36" />
            </VerticalStackLayout>
        </Border>
        <Label Text="{Binding Responsable, StringFormat='Responsable : {0}'}" HorizontalOptions="Center" FontSize="13" TextColor="{StaticResource TextGray}" IsVisible="{Binding EstAgence}" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <Border Stroke="{StaticResource Gray100}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,10" BackgroundColor="White">
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="{Binding NbAnnonces}" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" />
                    <Label Text="Annonces" Style="{StaticResource CardSpecs}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Stroke="{StaticResource Gray100}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,10" BackgroundColor="White">
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="{Binding NbFavoris}" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" />
                    <Label Text="Favoris" Style="{StaticResource CardSpecs}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
        <Border Stroke="{StaticResource Gray100}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="0" BackgroundColor="White">
            <VerticalStackLayout Spacing="0">
                <Grid ColumnDefinitions="*,Auto" Padding="14,12" ColumnSpacing="10">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding MesAnnoncesCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="Mes annonces" FontSize="15" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="›" FontSize="20" TextColor="{StaticResource TextGray}" VerticalOptions="Center" />
                </Grid>
                <BoxView HeightRequest="1" Color="{StaticResource Gray100}" />
                <Grid ColumnDefinitions="*,Auto" Padding="14,12" ColumnSpacing="10">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ModifierTelephoneCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="Modifier le téléphone" FontSize="15" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="›" FontSize="20" TextColor="{StaticResource TextGray}" VerticalOptions="Center" />
                </Grid>
                <BoxView HeightRequest="1" Color="{StaticResource Gray100}" />
                <Grid ColumnDefinitions="*,Auto" Padding="14,12" ColumnSpacing="10">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ModifierMotDePasseCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="Modifier le mot de passe" FontSize="15" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="›" FontSize="20" TextColor="{StaticResource TextGray}" VerticalOptions="Center" />
                </Grid>
                <BoxView HeightRequest="1" Color="{StaticResource Gray100}" IsVisible="{Binding EstAgence}" />
                <Grid ColumnDefinitions="*,Auto" Padding="14,12" ColumnSpacing="10" IsVisible="{Binding EstAgence}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ModifierAgenceCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="Modifier les infos agence" FontSize="15" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="›" FontSize="20" TextColor="{StaticResource TextGray}" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>
        <Button Text="Se déconnecter" Command="{Binding DeconnecterCommand}" BackgroundColor="Transparent" TextColor="{StaticResource PriceRed}" BorderColor="{StaticResource PriceRed}" BorderWidth="1" CornerRadius="12" FontAttributes="Bold" />
    </VerticalStackLayout>
    </ScrollView>
</ContentPage>
